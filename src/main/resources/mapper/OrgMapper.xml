<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ordermanager.mapper.OrgMapper">

    <resultMap id="BaseMap" type="Organization">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="label" property="label"/>
        <result column="sname" property="sname"/>
        <result column="level" property="level"/>
        <result column="parent" property="parent"/>
        <result column="contact" property="contact"/>
        <result column="phone" property="phone"/>
        <result column="region" property="region"/>
        <result column="address" property="address"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="BaseColumns">id, code, label, sname, level, parent, contact, phone, region, address, remark, create_time</sql>

    <sql id="WhereClause">
        <where>
            <if test="code != null and code != ''">AND code LIKE CONCAT('%', #{code}, '%')</if>
            <if test="label != null and label != ''">AND label LIKE CONCAT('%', #{label}, '%')</if>
            <if test="sname != null and sname != ''">AND sname LIKE CONCAT('%', #{sname}, '%')</if>
            <if test="level != null and level != ''">AND level = #{level}</if>
        </where>
    </sql>

    <select id="selectList" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_organization
        <include refid="WhereClause"/>
        ORDER BY id
    </select>

    <select id="selectById" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_organization WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_organization WHERE code = #{code}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tb_organization (code, label, sname, level, parent, contact, phone, region, address, remark)
        VALUES (#{code}, #{label}, #{sname}, #{level}, #{parent}, #{contact}, #{phone}, #{region}, #{address}, #{remark})
    </insert>

    <update id="update">
        UPDATE tb_organization
        SET label = #{label}, sname = #{sname}, level = #{level}, parent = #{parent},
            contact = #{contact}, phone = #{phone}, region = #{region}, address = #{address}, remark = #{remark}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tb_organization WHERE id = #{id}
    </delete>

    <select id="selectChildren" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_organization WHERE parent = #{parent} ORDER BY id
    </select>

    <select id="selectAll" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_organization ORDER BY id
    </select>
</mapper>
