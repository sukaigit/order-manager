<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ordermanager.mapper.RoleFunctionMapper">

    <resultMap id="BaseMap" type="RoleFunction">
        <id column="id" property="id"/>
        <result column="role_id" property="roleId"/>
        <result column="func_code" property="funcCode"/>
    </resultMap>

    <sql id="BaseColumns">id, role_id, func_code</sql>

    <select id="selectByRoleId" resultMap="BaseMap">
        SELECT <include refid="BaseColumns"/> FROM tb_role_function WHERE role_id = #{roleId}
    </select>

    <select id="selectFuncCodesByRoleId" resultType="string">
        SELECT func_code FROM tb_role_function WHERE role_id = #{roleId}
    </select>

    <insert id="insertBatch">
        INSERT INTO tb_role_function (role_id, func_code) VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.roleId}, #{item.funcCode})
        </foreach>
    </insert>

    <delete id="deleteByRoleId">
        DELETE FROM tb_role_function WHERE role_id = #{roleId}
    </delete>

    <delete id="deleteByFuncCode">
        DELETE FROM tb_role_function WHERE func_code = #{funcCode}
    </delete>
</mapper>
